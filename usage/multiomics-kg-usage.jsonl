{"timestamp":"2026-11-03T13:06:48Z","template_version":"0.2.0-alpha.2","event":"PostToolUse","session_id":"2717cf1a-a7fc-4bef-8041-fe8aec678e10","tool_name":"mcp__multiomics-kg__run_cypher","tool_input":{"query":"MATCH (p:KeggTerm {id:'kegg.pathway:ko01230'})<-[:Kegg_term_is_a_kegg_term*1..3]-(ko:KeggTerm)<-[:Gene_has_kegg_ko]-(g:Gene)\nWITH DISTINCT g\nMATCH (e:Experiment)-[r:Changes_expression_of]->(g)\nWHERE (e.organism_name STARTS WITH 'Prochlorococcus' AND any(x IN e.coculture_partner WHERE x CONTAINS 'Alteromonas'))\n   OR (e.organism_name STARTS WITH 'Alteromonas' AND any(x IN e.coculture_partner WHERE x CONTAINS 'Prochlorococcus'))\nWITH e, count(DISTINCT g) AS aa_genes_measured,\n     count(DISTINCT CASE WHEN r.expression_status='significant_up' THEN g END) AS aa_genes_up_any_tp,\n     count(DISTINCT CASE WHEN r.expression_status='significant_down' THEN g END) AS aa_genes_down_any_tp\nRETURN e.organism_name AS organism, e.omics_type AS omics, e.id AS experiment, e.table_scope AS scope, e.distinct_gene_count AS genes_total, aa_genes_measured, aa_genes_up_any_tp, aa_genes_down_any_tp\nORDER BY omics, organism, experiment","limit":60},"response_keys":["results","returned","truncated","warnings"],"truncated":false,"total_matching":null,"returned":39,"error":null}
{"timestamp":"2026-11-03T13:06:57Z","template_version":"0.2.0-alpha.2","event":"PostToolUse","session_id":"2717cf1a-a7fc-4bef-8041-fe8aec678e10","tool_name":"mcp__multiomics-kg__run_cypher","tool_input":{"query":"MATCH (p:KeggTerm {id:'kegg.pathway:ko01230'})<-[:Kegg_term_is_a_kegg_term*1..3]-(ko:KeggTerm)<-[:Gene_has_kegg_ko]-(g:Gene)\nWHERE g.organism_name IN ['Prochlorococcus MED4','Prochlorococcus MIT9313','Prochlorococcus MIT9312','Prochlorococcus NATL2A','Prochlorococcus marinus subsp. marinus CCMP1375 (SS120)','Alteromonas macleodii HOT1A3','Alteromonas macleodii MIT1002','Alteromonas macleodii EZ55','Alteromonas (MarRef v6)']\nRETURN g.organism_name AS organism, count(DISTINCT g) AS aa_biosynthesis_genes ORDER BY organism"},"response_keys":["results","returned","truncated","warnings"],"truncated":false,"total_matching":null,"returned":9,"error":null}
{"timestamp":"2026-11-03T13:09:21Z","template_version":"0.2.0-alpha.2","event":"PostToolUse","session_id":"2717cf1a-a7fc-4bef-8041-fe8aec678e10","tool_name":"mcp__multiomics-kg__run_cypher","tool_input":{"query":"MATCH (e:Experiment) WHERE e.id STARTS WITH '10.1101/2025.11.24.690089'\nRETURN e.id AS id, e.organism_name AS org, e.omics_type AS omics, e.treatment_type AS tt, e.background_factors AS bg, e.coculture_partner AS partner, e.treatment AS treatment, e.control AS control, e.medium AS medium, e.light_condition AS light, e.light_intensity AS li, e.temperature AS temp, e.statistical_test AS stat, e.table_scope AS scope, e.control_timing AS ct, e.time_point_labels AS tps, e.time_point_growth_phases AS gp, e.time_point_significant_up AS up, e.time_point_significant_down AS down, e.distinct_gene_count AS n, e.design_notes AS notes\nORDER BY org, omics, id","limit":20},"response_keys":["results","returned","truncated","warnings"],"truncated":false,"total_matching":null,"returned":10,"error":null}
{"timestamp":"2026-11-03T13:09:30Z","template_version":"0.2.0-alpha.2","event":"PostToolUse","session_id":"2717cf1a-a7fc-4bef-8041-fe8aec678e10","tool_name":"mcp__multiomics-kg__run_cypher","tool_input":{"query":"MATCH (p:KeggTerm {id:'kegg.pathway:ko01230'})<-[:Kegg_term_is_a_kegg_term*1..3]-(:KeggTerm)<-[:Gene_has_kegg_ko]-(g:Gene)\nWITH DISTINCT g\nMATCH (e:Experiment)-[r:Changes_expression_of]->(g) WHERE e.id STARTS WITH '10.1101/2025.11.24.690089'\nWITH e, r.time_point AS tp, r.time_point_order AS o, count(DISTINCT g) AS n,\n count(DISTINCT CASE WHEN r.expression_status='significant_up' THEN g END) AS up,\n count(DISTINCT CASE WHEN r.expression_status='significant_down' THEN g END) AS dn\nRETURN e.organism_name AS org, e.omics_type AS omics, split(e.id,'690089_')[1] AS exp, o, tp, n, up, dn ORDER BY org, omics, exp, o","limit":60},"response_keys":["results","returned","truncated","warnings"],"truncated":false,"total_matching":null,"returned":34,"error":null}
